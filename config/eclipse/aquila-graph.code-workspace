{
  "folders": [
    {
      "path": "../..",
      "name": "aquila-graph"
    },
    {
      "path": "org.aquilagraph.identity"
    },
    {
      "path": "org.aquilagraph.source"
    },
    {
      "path": "org.aquilagraph.cfg"
    },
    {
      "path": "org.aquilagraph.frontend"
    },
    {
      "path": "org.aquilagraph.application"
    },
    {
      "path": "org.aquilagraph.repository"
    },
    {
      "path": "org.aquilagraph.library"
    },
    {
      "path": "org.aquilagraph.cli"
    },
    {
      "path": "org.aquilagraph.observability"
    },
    {
      "path": "aquila-graph-tests"
    },
    {
      "path": "aquila-graph-build"
    }
  ],
  "settings": {
    "java.import.maven.enabled": false,
    "java.autobuild.enabled": false,
    "java.import.exclusions": [
      "**/node_modules/**",
      "**/.metadata/**",
      "**/target/**",
      "!**/target/editor/**"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build: compile",
        "type": "process",
        "command": "java",
        "args": [
          "--enable-native-access=ALL-UNNAMED",
          "${workspaceFolder:aquila-graph}/config/build/org/aquilagraph/build/BuildExecution.java",
          "compile"
        ],
        "options": {
          "cwd": "${workspaceFolder:aquila-graph}"
        },
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Build: test",
        "type": "process",
        "command": "java",
        "args": [
          "--enable-native-access=ALL-UNNAMED",
          "${workspaceFolder:aquila-graph}/config/build/org/aquilagraph/build/BuildExecution.java",
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder:aquila-graph}"
        },
        "problemMatcher": []
      }
    ]
  }
}
