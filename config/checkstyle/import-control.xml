<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.5//EN"
    "https://checkstyle.org/dtds/import_control_1_5.dtd">

<import-control pkg="org.aquilagraph">
  <disallow pkg="com.sun.tools.javac" />
  <disallow pkg="jdk.internal" />
  <disallow pkg="sun" />
  <disallow pkg="com.sun.source" />
  <disallow pkg="javax.lang.model" />
  <disallow pkg="javax.tools" />
  <disallow pkg="org.neo4j" />
  <disallow class="org.aquilagraph.source.api.AstAggregateAdmission" />
  <allow pkg=".*" regex="true" />

  <subpackage name="identity">
    <allow pkg="java" />
    <allow pkg="org.aquilagraph.identity.api" />
    <allow class="org.jspecify.annotations.NullMarked" />
    <allow class="org.jspecify.annotations.Nullable" />
    <disallow pkg=".*" regex="true" />
  </subpackage>

  <subpackage name="source">
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
    <subpackage name="api">
      <disallow class="org.aquilagraph.source.api.AstAggregateAdmission" />
      <disallow pkg="org.aquilagraph.source.admission" />
      <disallow pkg="org.aquilagraph.source.internal" />
      <file name="AstAggregateAdmission(?:\.java)?" regex="true">
        <allow class="org.aquilagraph.source.admission.CopiedAstValues" />
      </file>
    </subpackage>
    <subpackage name="admission">
      <allow class="org.aquilagraph.source.api.AstAggregateAdmission" />
    </subpackage>
  </subpackage>

  <subpackage name="model">
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="syntax">
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="cfg">
    <disallow pkg="org.aquilagraph.source.admission" />
    <disallow pkg="org.aquilagraph.source.internal" />
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="frontend">
    <disallow pkg="org.aquilagraph.source.internal" />
    <allow pkg="com.sun.source" />
    <allow pkg="javax.lang.model" />
    <allow pkg="javax.tools" />
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="application">
    <disallow class="org.aquilagraph.cfg.api.GraphValueAdmission" />
    <disallow class="org.aquilagraph.cfg.api.LoweringPlan" />
    <disallow class="org.aquilagraph.cfg.api.CfgAdmissionResult" />
    <allow pkg="org.aquilagraph.cfg.api" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.source.admission" />
    <disallow class="org.aquilagraph.source.api.AstAggregateAdmission" />
    <disallow class="org.aquilagraph.source.api.JavaAstAggregateBuilder" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="cli">
    <disallow class="org.aquilagraph.cfg.api.GraphValueAdmission" />
    <disallow class="org.aquilagraph.cfg.api.LoweringPlan" />
    <allow pkg="org.aquilagraph.cfg.api" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.frontend" />
    <disallow pkg="org.aquilagraph.repository" />
  </subpackage>

  <subpackage name="repository">
    <disallow pkg="org.aquilagraph.application" />
    <disallow pkg="org.aquilagraph.cli" />
    <disallow pkg="org.aquilagraph.cfg" />
    <disallow pkg="org.aquilagraph.frontend" />
    <subpackage name="neo4j">
      <allow pkg="org.aquilagraph.cfg.api" />
      <allow class="org.aquilagraph.application.AnalysisRun" />
      <allow class="org.aquilagraph.application.AnalysisCompletion" />
      <allow class="org.aquilagraph.application.ProgramRepresentation" />
      <allow class="org.aquilagraph.application.AstLookup" />
      <allow class="org.aquilagraph.application.AstLookupStatus" />
      <allow class="org.aquilagraph.application.CommitKnowledge" />
      <allow class="org.aquilagraph.application.RepositoryOperationContext" />
      <allow class="org.aquilagraph.application.RepositoryOperationException" />
      <allow class="org.aquilagraph.application.RepositoryOperationKind" />
      <allow class="org.aquilagraph.application.RepositoryPhase" />
      <allow pkg="org.aquilagraph.application.port" />
      <allow pkg="org.neo4j" />
    </subpackage>
  </subpackage>
</import-control>
