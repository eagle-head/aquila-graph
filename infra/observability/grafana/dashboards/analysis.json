{
  "uid": "aquila-analysis",
  "title": "Aquila | Execution and AST",
  "tags": [
    "aquila",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Aquila dashboards",
      "type": "dashboards",
      "tags": [
        "aquila"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "execution",
        "label": "Execution (newest first)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aquila-metrics"
        },
        "query": {
          "query": "query_result(sort_desc(last_over_time(aquila_execution_started_seconds[$__range]) and on(aquila_execution_id) last_over_time(aquila_execution_state[$__range])))",
          "refId": "ExecutionVariable"
        },
        "definition": "query_result(sort_desc(last_over_time(aquila_execution_started_seconds[$__range]) and on(aquila_execution_id) last_over_time(aquila_execution_state[$__range])))",
        "regex": "/aquila_execution_id=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Execution isolation",
      "description": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Select one execution above (newest first). Historical runs remain separate. **Running** requires a recent heartbeat; **Telemetry interrupted** means the final result is unknown. Translated nodes are available before final admission. Use the time picker to find older runs."
      }
    },
    {
      "id": 2,
      "title": "Execution state",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aquila-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisBorderShow": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Running",
                  "color": "blue"
                },
                "1": {
                  "text": "Complete",
                  "color": "green"
                },
                "2": {
                  "text": "Incomplete",
                  "color": "yellow"
                },
                "3": {
                  "text": "Failed",
                  "color": "red"
                },
                "4": {
                  "text": "Cancelled",
                  "color": "orange"
                },
                "5": {
                  "text": "Telemetry interrupted",
                  "color": "red"
                },
                "6": {
                  "text": "Succeeded",
                  "color": "green"
                },
                "7": {
                  "text": "Aborted",
                  "color": "red"
                },
                "8": {
                  "text": "AST unavailable",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(last_over_time(aquila_execution_state{aquila_execution_id=\"$execution\"}[$__range]) != 0) or ((last_over_time(aquila_execution_state{aquila_execution_id=\"$execution\"}[$__range]) == 0) and on(aquila_execution_id) (time() - last_over_time(aquila_execution_heartbeat_seconds{aquila_execution_id=\"$execution\"}[$__range]) < 20)) or (5 + 0 * ((last_over_time(aquila_execution_state{aquila_execution_id=\"$execution\"}[$__range]) == 0) and on(aquila_execution_id) (time() - last_over_time(aquila_execution_heartbeat_seconds{aquila_execution_id=\"$execution\"}[$__range]) >= 20)))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "aquila-metrics"
          },
          "exemplar": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
