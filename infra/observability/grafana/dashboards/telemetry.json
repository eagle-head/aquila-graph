    {
      "id": 12,
      "title": "SDK dropped records \u2014 per SDK instance",
      "description": "Per-instance cumulative SDK loss; never summed across old and new SDKs. Absent before SDK internal metrics are emitted. Only the selected SDK instance is shown; older instances are selectable separately.",
