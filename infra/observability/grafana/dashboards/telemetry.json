{
  "uid": "aquila-telemetry",
  "title": "Aquila | Telemetry infrastructure",
  "tags": [
    "aquila",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Aquila dashboards",
      "type": "dashboards",
      "tags": [
        "aquila"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "sdk_instance",
        "label": "SDK instance (newest first)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aquila-metrics"
        },
        "query": {
          "query": "query_result(sort_desc(max by (instance) (last_over_time(aquila_execution_started_seconds[$__range]) and on(aquila_execution_id) last_over_time(aquila_execution_state[$__range]))))",
          "refId": "SDK instances"
        },
        "definition": "query_result(sort_desc(max by (instance) (last_over_time(aquila_execution_started_seconds[$__range]) and on(aquila_execution_id) last_over_time(aquila_execution_state[$__range]))))",
        "regex": "/instance=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Shared infrastructure",
      "description": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Shared service measurements for the selected time range. Availability confirms a successful metrics scrape; queues, refused data, send failures and SDK drops help verify delivery. AST results stay in the execution dashboard. Queue utilization uses a 0\u2013100% scale. SDK panels use the single selected SDK instance; they do not combine earlier and newer processes."
      }
    },
    {
      "id": 2,
