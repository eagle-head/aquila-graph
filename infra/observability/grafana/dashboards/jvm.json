        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aquila_execution_jvm_memory_used_bytes{aquila_execution_id=\"$execution\",memory_type=\"heap\"} / aquila_execution_jvm_memory_limit_bytes{aquila_execution_id=\"$execution\",memory_type=\"heap\"} and on(aquila_execution_id) (time() - aquila_execution_heartbeat_seconds{aquila_execution_id=\"$execution\"} < 20)",
