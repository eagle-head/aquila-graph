{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["maven", "maven-wrapper"],
  "dependencyDashboard": {
    "enabled": true
  },
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
