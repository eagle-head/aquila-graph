# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,py}]
max_line_length = 140

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[mvnw]
end_of_line = lf

[src/main/launch/aquila-graph]
end_of_line = lf
